OPENAI_API_KEY=sk-your-server-owned-key
OPENAI_CHAT_MODEL=gpt-5.4-mini
OPENAI_FEEDBACK_MODEL=gpt-5.4
APP_BASE_URL=http://localhost:4173

# Comma-separated emails that can open the admin tab.
ADMIN_EMAILS=owner@example.com

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Kakao OAuth
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=

# Local development only. In production, set NODE_ENV=production or ENABLE_DEV_LOGIN=false.
ENABLE_DEV_LOGIN=true
