NODE_ENV=development
PORT=4173
APP_BASE_URL=http://localhost:4173
ENABLE_DEV_LOGIN=true
STORAGE_DIR=./storage

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Langfuse (prompt management + tracing) — https://langfuse.com/docs/prompt-management/get-started
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# LANGFUSE_BASE_URL is an alias accepted by the JS SDK
# production | staging — which labeled prompt version the app fetches
LANGFUSE_PROMPT_LABEL=production
LANGFUSE_PROMPT_REFRESH_MS=60000
# Set false to disable tracing while keeping prompt fetch
# LANGFUSE_TRACING_ENABLED=false
# Include full assembled prompt in generation span (default: preview only)
# LANGFUSE_TRACE_FULL_PROMPT=true
OPENAI_CHAT_MODEL=gpt-5.4-mini
OPENAI_CHAT_REASONING_EFFORT=high
OPENAI_FEEDBACK_MODEL=gpt-5.4
OPENAI_FEEDBACK_REASONING_EFFORT=medium

ADMIN_EMAILS=
SESSION_SECRET=
USD_TO_KRW=1480
EXCHANGE_RATE_API_URL=https://api.frankfurter.dev/v1/latest?base=USD&symbols=KRW
EXCHANGE_RATE_REFRESH_MS=21600000
EXCHANGE_RATE_TIMEOUT_MS=4000
OPENAI_CHAT_INPUT_USD_PER_1M=0.75
OPENAI_CHAT_OUTPUT_USD_PER_1M=4.5
OPENAI_FEEDBACK_INPUT_USD_PER_1M=2.5
OPENAI_FEEDBACK_OUTPUT_USD_PER_1M=15

SUPABASE_URL=https://wyqpcldqlyrqbppjdhhp.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
